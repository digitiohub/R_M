# Copy to .env.local for local work. In Coolify, set these as environment variables.
# Variables marked (build) are inlined into the browser bundle, so they must also be
# passed as Docker build args (the Dockerfile already declares them).

# Form delivery (runtime). Without RESEND_API_KEY the audit form returns an error unless the
# Cloudflare D1 binding is available.
RESEND_API_KEY=
AUDIT_EMAIL_TO=hello@retentionmax.in
# The sender domain must be verified in Resend.
AUDIT_EMAIL_FROM=RetentionMax Website <hello@retentionmax.in>

# AI assistant (runtime)
ANTHROPIC_API_KEY=

# Footer and chat contact links (build). Leave empty to hide the icon.
NEXT_PUBLIC_RETENTIONMAX_LINKEDIN=
NEXT_PUBLIC_VISHAL_WHATSAPP=
NEXT_PUBLIC_RETENTIONMAX_WHATSAPP=

# Search engine ownership tokens (build), issued by Google Search Console and Bing Webmaster Tools.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
